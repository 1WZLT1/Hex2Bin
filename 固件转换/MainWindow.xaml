<Window x:Class="固件转换.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:固件转换"
        mc:Ignorable="d"
        Title="固件转换" Height="150" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Label Content="HEX固件地址:" Margin="0,5,0,0"></Label>
            <TextBox Margin="104,5,67,5" Text="{Binding HexDocumentAddress}" TextAlignment="Center"/>
            <Button Content="选择"  Command="{Binding DocumentAddressSelect}" Margin="738,5,15,5"/>
        </Grid>
        <Grid Grid.Row="1">
            <Label Content="Bin文件存放地址:" Margin="0,5,0,0"></Label>
            <TextBox Margin="105,5,68,5" Text="{Binding BinDocumentAddress}" TextAlignment="Center"/>
            <Button Content="选择" Command="{Binding DocumentAddressSelect}" Margin="738,5,15,5" />
        </Grid>
        <Grid Grid.Row="2" >
            <Button Content="转换"  Command="{Binding ConvertFirmwareCommand}" Margin="640,0,90,0"/>
            <Button Content="退出" Margin="715,0,15,0"/>
        </Grid>
    </Grid>
</Window>
